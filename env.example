# Firebase Configuration
# Copy this file to .env.local and fill in your actual Firebase values

# Firebase Core Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=your-app-id

# Firebase Functions Configuration
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# Application Configuration
VITE_APP_NAME=Blackwater Industries
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=development

# Feature Flags
VITE_USE_MOCK_AUTH=false
VITE_ENABLE_MT5_INTEGRATION=true
VITE_ENABLE_MYFXBOOK_INTEGRATION=true
VITE_ENABLE_AI_INSIGHTS=true
VITE_ENABLE_ESG_ANALYSIS=true
VITE_ENABLE_CREDIT_ANALYSIS=true
VITE_ENABLE_RISK_MANAGEMENT=true
VITE_ENABLE_COMPLIANCE=true
VITE_ENABLE_FUNDRAISING=true

# External API Keys (Optional)
VITE_YAHOO_FINANCE_API_KEY=your-yahoo-api-key
VITE_ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
VITE_POLYGON_API_KEY=your-polygon-api-key
VITE_FINNHUB_API_KEY=your-finnhub-api-key

# MT5 Configuration
VITE_MT5_SERVER_URL=your-mt5-server-url
VITE_MT5_LOGIN=your-mt5-login
VITE_MT5_PASSWORD=your-mt5-password

# Myfxbook Configuration
VITE_MYFXBOOK_API_KEY=your-myfxbook-api-key
VITE_MYFXBOOK_SECRET=your-myfxbook-secret

# Analytics and Monitoring
VITE_ENABLE_ANALYTICS=true
VITE_ANALYTICS_ID=your-analytics-id
VITE_SENTRY_DSN=your-sentry-dsn

# Security
VITE_SESSION_TIMEOUT=3600000
VITE_MAX_LOGIN_ATTEMPTS=5
VITE_LOCKOUT_DURATION=900000

# Performance
VITE_CACHE_DURATION=300000
VITE_MAX_CACHE_SIZE=100
VITE_ENABLE_OFFLINE_SUPPORT=true 